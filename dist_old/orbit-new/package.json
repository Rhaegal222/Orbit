{
  "name": "@galileo/orbit",
  "version": "0.1.0",
  "description": "Reusable UI foundations and design tokens for Galileo applications.",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": [
    "./styles/styles.css",
    "./styles/tokens.css",
    "./styles/theme.css"
  ],
  "exports": {
    "./styles": "./styles/styles.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/theme.css": "./styles/theme.css",
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
