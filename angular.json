{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "orbit": {
      "projectType": "library",
      "root": "projects/orbit",
      "sourceRoot": "projects/orbit/src",
      "prefix": "orbit",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/orbit/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/orbit/tsconfig.lib.json"
            },
            "development": {
              "tsConfig": "projects/orbit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/orbit/tsconfig.spec.json"
          }
        }
      }
    },
    "orbit-lab": {
      "projectType": "application",
      "root": "projects/orbit-lab",
      "sourceRoot": "projects/orbit-lab/src",
      "prefix": "lab",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/orbit-lab/src/main.ts",
            "index": "projects/orbit-lab/src/index.html",
            "tsConfig": "projects/orbit-lab/tsconfig.app.json",
            "styles": ["projects/orbit/src/styles/styles.css", "projects/orbit-lab/src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "orbit-lab:build:production"
            },
            "development": {
              "buildTarget": "orbit-lab:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/orbit-lab/tsconfig.spec.json"
          }
        }
      }
    },
    "orbit-studio": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/orbit-studio",
      "sourceRoot": "projects/orbit-studio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/orbit-studio/src/main.ts",
            "tsConfig": "projects/orbit-studio/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/orbit-studio/public"
              }
            ],
            "styles": ["projects/orbit-studio/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "orbit-studio:build:production"
            },
            "development": {
              "buildTarget": "orbit-studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
