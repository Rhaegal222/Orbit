{
  "name": "@galileo/orbit-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve orbit-lab",
    "start:studio": "ng serve orbit-studio",
    "build": "ng build orbit",
    "build:lab": "ng build orbit-lab",
    "build:studio": "ng build orbit-studio",
    "test": "ng test orbit-lab",
    "test:core": "ng test orbit --watch=false",
    "lint": "ng lint",
    "format:check": "prettier --config .prettierrc --list-different \"projects/**/*.{ts,html,css,json}\"",
    "format:write": "prettier --config .prettierrc --write \"projects/**/*.{ts,html,css,json}\"",
    "pack:check": "npm run build && cd dist/orbit-new && npm pack --dry-run",
    "check": "npm run build && npm run pack:check"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cdk": "^22.0.0",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
