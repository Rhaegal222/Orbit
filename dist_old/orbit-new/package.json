    "@angular/cdk": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.galileo.test/galileo/orbit.git"
  },
  "bugs": {
    "url": "https://gitlab.galileo.test/galileo/orbit/-/issues"
  },
  "homepage": "https://gitlab.galileo.test/galileo/orbit#readme",
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.22.3"
